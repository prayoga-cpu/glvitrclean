# There is deliberately no NEXT_PUBLIC_SITE_URL. The production origin is the
# SITE_URL constant in src/data/company.ts, and nothing reads it from the
# environment: a write-only Vercel variable overriding it is what kept every
# canonical on the old domain after the move to glvitr-clean.com. See the
# comment on SITE_URL. Nothing reads it now; do not add it here, and delete
# any copy left on the Vercel project rather than re-pointing it.

# --- Quote form (api/submit.ts, api/_lib/email.ts) --------------------------
# Server-side only — never prefix these NEXT_PUBLIC_. The Next.js app stays a
# static export (CLAUDE.md rule 2); api/submit.ts is a separate Vercel Edge
# Function that the form calls same-origin. Unset RESEND_API_KEY = the
# endpoint returns 503 and sends nothing.
RESEND_API_KEY=

# Optional. Sender identity, which MUST be a domain verified in the Resend
# account. Defaults to the client's brand name over PRIONATION's verified
# prionation.io domain (glvitr-clean.com is not verified there — that needs
# DNS records at its registrar, Squarespace, which is human-only work, see
# CLAUDE.md rule 7). Set this to "GLVITR'CLEAN <devis@glvitr-clean.com>" once
# glvitr-clean.com is verified, and nothing else needs to change.
MAIL_FROM=

# Optional, comma-separated. Who gets notified of every submission. Defaults
# to thibautglossoa@gmail.com + prayogadevelopment@gmail.com +
# gaelgdu91@gmail.com. When this is set it REPLACES the default rather than
# adding to it, so a new recipient has to be added here too (and in the Vercel
# project's env, which is what production reads). Override in local/preview
# environments so test submissions don't reach the client.
MAIL_TEAM_RECIPIENTS=

# Optional, comma-separated. Extra origins api/submit.ts accepts a POST from,
# beyond the request's own Host header and the Vercel deployment URLs it
# already allows. Usually left unset.
ALLOWED_ORIGINS=

# The SAP declaration number is deliberately NOT an env var. It is a reviewed
# edit to `company.sapDeclaration.number` in src/data/company.ts, because
# scripts/check-compliance.mjs reads that file to decide whether the tax-credit
# badge is allowed to leave pending mode. An env var would let the badge go
# live without the guard ever seeing it. See docs/04-compliance-sap.md.
