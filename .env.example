# Public site URL, used for canonicals and sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.glvitrclean.com

# --- Quote form (api/submit.ts, api/_lib/email.ts) --------------------------
# Server-side only — never prefix these NEXT_PUBLIC_. The Next.js app stays a
# static export (CLAUDE.md rule 2); api/submit.ts is a separate Vercel Edge
# Function that the form calls same-origin. Unset RESEND_API_KEY = the
# endpoint returns 503 and sends nothing.
RESEND_API_KEY=

# Optional. Sender identity, which MUST be a domain verified in the Resend
# account. Defaults to the client's brand name over PRIONATION's verified
# prionation.io domain (glvitrclean.com is not verified there — that needs
# DNS records, which is human-only work, see CLAUDE.md rule 7). Set this to
# "GLVITR'CLEAN <devis@glvitrclean.com>" once glvitrclean.com is verified,
# and nothing else needs to change.
MAIL_FROM=

# Optional, comma-separated. Who gets notified of every submission. Defaults
# to thibautglossoa@gmail.com + prayogadevelopment@gmail.com. Override in
# local/preview environments so test submissions don't reach the client.
MAIL_TEAM_RECIPIENTS=

# Optional, comma-separated. Extra origins api/submit.ts accepts a POST from,
# beyond the request's own Host header and the Vercel deployment URLs it
# already allows. Usually left unset.
ALLOWED_ORIGINS=

# The SAP declaration number is deliberately NOT an env var. It is a reviewed
# edit to `company.sapDeclaration.number` in src/data/company.ts, because
# scripts/check-compliance.mjs reads that file to decide whether the tax-credit
# badge is allowed to leave pending mode. An env var would let the badge go
# live without the guard ever seeing it. See docs/04-compliance-sap.md.
